{
  "envOverrides": {
    "/service/bindAddress": "SERVICE_BIND_ADDRESS"
  },
  "service": {
    "name": "skw-ws-gate",
    "bindAddress": "0.0.0.0:443",
    "workers": 2,
    "backTopicpartitionsCount": 7,
    "tls": {
      "subjectAltNames": ["localhost", "127.0.0.1", "skw-api-gate"],
      "certPath": "./skw-api-gate.cert.pem",
      "keyPath": "./skw-api-gate.key.pem"
    },
    "authServiceUrl": "http://skw-auth-service",
    "rootKey": "01a01500-98d5-71fc-9038-71acb78d61c4",
    "heartbeatIntervalSecs": 5,
    "clientTimeoutSecs": 10
  },
  "iggy": {
    "url": "iggy://iggy:Secret123!@skw-iggy:3000",
    "streamPrefix": "api-gate-stream"
  },
  "topicsMap": {
    "ping":{
      "customName": "",
      "partitionsCount": 10,
      "messageExpiry": 31
    }
  }
}
